# ── Database (required) ──────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Email domain (required for address generation) ───────────────
# Must match the domain that receives mail via your provider / MX records
EMAIL_DOMAIN=yourdomain.com

# ── Inbound provider ─────────────────────────────────────────────
# mailgun | resend | generic
INBOUND_PROVIDER=mailgun

# Webhook signing secret (required in production)
# Mailgun: Webhook Signing Key (Settings → API Security) — NOT the API key
# Resend:  Signing secret from webhook details page (starts with whsec_)
# Generic: shared secret for header X-Webhook-Signature: sha256=<hex>
INBOUND_WEBHOOK_SECRET=your_webhook_signing_secret

# Resend only: API key with permission to retrieve received emails
# Required because Resend webhooks do not include message bodies
# https://resend.com/docs/api-reference/emails/retrieve-received-email
RESEND_API_KEY=

# Rate limit: max address creations per IP per minute (default 10)
RATE_LIMIT_GENERATE=10

# Public app URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: dedicated DB URL for rate-limit concurrency integration tests (never production)
# RATE_LIMIT_TEST_DATABASE_URL=

