# Database (Neon PostgreSQL) — required
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Email domain for generated addresses (must match inbound provider domain)
EMAIL_DOMAIN=yourdomain.com

# Inbound provider: mailgun | resend | generic
INBOUND_PROVIDER=mailgun

# Webhook signing secret (required in production)
# Mailgun: Webhook Signing Key from Settings → API Security
# Resend:  Signing secret from webhook details (starts with whsec_)
# Generic: shared HMAC secret for X-Webhook-Signature: sha256=<hex>
INBOUND_WEBHOOK_SECRET=your_webhook_signing_secret

# Resend only: API key to fetch full message when webhook payload is minimal
RESEND_API_KEY=

# Rate limit: max address creations per IP per minute (default 10)
RATE_LIMIT_GENERATE=10

# Public app URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
