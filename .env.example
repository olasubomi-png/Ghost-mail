# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Email domain for generated addresses (must match your inbound provider domain)
EMAIL_DOMAIN=yourdomain.com

# Inbound email provider webhook secret (for signature verification)
# Supported: mailgun, resend, generic
INBOUND_PROVIDER=mailgun
INBOUND_WEBHOOK_SECRET=your_webhook_signing_secret

# Optional: rate limiting (requests per minute for address generation)
RATE_LIMIT_GENERATE=10

# App URL (used for absolute links if needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000
